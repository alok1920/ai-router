# AI Router — Environment Variables
# Copy this file to .env and fill in your real API keys
# Run: cp .env.example .env
# NEVER commit the .env file — it is in .gitignore

# ── Free Tier Providers ────────────────────────────────────────
# Gemini — free tier: 1500 requests/day
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name — update here if Google changes it again
# Find current models at: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Groq — free tier: generous daily quota
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model name — update here if Groq decommissions a model
# Find current models at: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# ── Paid Providers (optional, add when ready) ─────────────────
# Anthropic Claude — pay per token
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — pay per token
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Router Settings ───────────────────────────────────────────
PORT=3000
SLIDING_WINDOW_SIZE=10
LOG_LEVEL=info
