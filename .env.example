# AI Router — Environment Variables
# Copy this file to .env and fill in your real API keys
# Run: cp .env.example .env
# NEVER commit the .env file — it is in .gitignore

# ── Free Tier Providers (start here) ──────────────────────────
# Gemini Flash — free tier: 1500 requests/day
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — free tier: generous daily quota
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Paid Providers (optional, add when ready) ─────────────────
# Anthropic Claude — pay per token
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — pay per token
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Router Settings ───────────────────────────────────────────
# Port for local HTTP server (used by web UI and browser extension)
PORT=3000

# How many recent messages to keep in full before compressing
SLIDING_WINDOW_SIZE=10

# Log level: info, warn, error
LOG_LEVEL=info
